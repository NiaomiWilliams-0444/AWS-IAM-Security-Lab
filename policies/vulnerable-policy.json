{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "OverPermissiveDeveloperAccess",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject",
                "s3:ListBucket",
                "s3:DeleteBucket",
                "s3:PutBucketPolicy"
            ],
            "Resource": "*"
        }
    ]
}